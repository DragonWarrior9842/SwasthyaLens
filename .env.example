# Public frontend configuration, loaded by Vite from the project root.
# Leave blank to use http://127.0.0.1:8000 for local development.
# Any VITE_ variable is visible to the browser. Never put a secret here.
VITE_API_BASE_URL=

# Backend configuration is separate: see backend/.env.example.
# Future server credentials belong only in backend/.env or a server secret store.
