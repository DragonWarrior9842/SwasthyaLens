# Server-only staging/production template; ALL blank required fields fail startup.
# Supply via the deployment secret store, never VITE_ variables or version control.
ENVIRONMENT=production
APP_ORIGIN=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_MODE=edge
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CSRF_SIGNING_KEY=
REPORT_PROCESSING_KEY=
OCR_TESSDATA_DIR=
REPORT_MAX_UPLOAD_BYTES=5242880
REPORT_PROCESSING_MAX_PAGES=20
REPORT_PROCESSING_TIMEOUT_SECONDS=120
# Do not set AI keys, RUN_AI_INTEGRATION or any test integration flag.
# AUTH_RATE_LIMIT_MODE=edge is a configuration requirement, not an installed gateway.
