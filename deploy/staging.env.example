# Server configuration. Required blanks deliberately prevent startup; no real values belong here.
ENVIRONMENT=staging
APP_ORIGIN=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_MODE=edge
OCR_TESSDATA_DIR=
REPORT_MAX_UPLOAD_BYTES=5242880
REPORT_PROCESSING_MAX_PAGES=20
REPORT_PROCESSING_TIMEOUT_SECONDS=120
# PUBLIC identifiers used server-side only by this architecture.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRET: generated independently for staging, populated privately by the operator.
CSRF_SIGNING_KEY=
REPORT_PROCESSING_KEY=
# FEATURE GATE: release startup rejects true.
PUBLIC_SIGNUP_ENABLED=false
# ABSENT: AI credentials/provider/model, RUN_AI_INTEGRATION and all integration flags.
# Frontend build: VITE_API_BASE_URL=/api; VITE_ENABLE_VOICE=false (separate build settings).
