# Server-only configuration. Copy to backend/.env if overriding defaults.
# Blank/unset uses ["http://localhost:5173", "http://127.0.0.1:5173"].
# To override, provide a JSON array of explicit HTTP(S) origins without paths.
# An empty array disables cross-origin access. Wildcards are rejected.
# Auth disabled only when all three SUPABASE/CSRF values are absent.
# When enabled, set CORS_ALLOWED_ORIGINS to ["http://127.0.0.1:5173"] locally.
CORS_ALLOWED_ORIGINS=
# Development is restricted to loopback HTTP. Production requires HTTPS, Secure
# cookies, a same-origin /api reverse proxy and AUTH_RATE_LIMIT_MODE=edge.
ENVIRONMENT=
APP_ORIGIN=
# Backend-only provider calls. Use the publishable key; never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate locally using secrets.token_urlsafe(32); never copy into VITE_ variables.
CSRF_SIGNING_KEY=
# local: bounded in-process limiter for one local development worker.
# edge: acknowledge separately configured production edge auth rate limiting.
AUTH_RATE_LIMIT_MODE=
# Server-side file limit in bytes, default 5242880 (5 MiB), maximum 5242880.
# The reviewed private reports bucket enforces the same maximum.
REPORT_MAX_UPLOAD_BYTES=
