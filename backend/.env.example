# Server-only configuration. Copy to backend/.env if overriding defaults.
# Blank/unset uses ["http://localhost:5173", "http://127.0.0.1:5173"].
# To override, provide a JSON array of explicit HTTP(S) origins without paths.
# An empty array disables cross-origin access. Wildcards are rejected.
# This phase requires no credentials or external services.
CORS_ALLOWED_ORIGINS=
