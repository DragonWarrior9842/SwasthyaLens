# Copy to backend/.env.integration; never commit the populated local file.
# Use two dedicated, distinct, confirmed development accounts with no health data.
# Set to 1 only after confirming these accounts are disposable test fixtures.
DISPOSABLE_TEST_ACCOUNTS_CONFIRMED=
# Optional defaults: API http://127.0.0.1:8000; app http://127.0.0.1:5173.
TEST_API_BASE_URL=
TEST_APP_ORIGIN=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
