# Copy to backend/.env.ai locally; never commit the filled file or paste its key.
# This separate file is read only by the backend AI settings.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_API_KEY=
# RUN_AI_INTEGRATION is a process environment opt-in, not a setting in this file.
# Leave it unset for ordinary application use and automated tests.
